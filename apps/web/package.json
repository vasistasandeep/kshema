{
  "name": "@kshema/web",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js 14 web app: public portal, Observer dashboard, ephemeral responder portal (edge SSR)",
  "scripts": {
    "predev": "node scripts/predev.mjs",
    "prebuild": "node scripts/predev.mjs",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "lint": "vitest run content/banned-terms.lint.test.ts",
    "lint:next": "next lint",
    "test": "vitest run --passWithNoTests",
    "dev": "next dev -p 3000",
    "start": "next start -p 3000",
    "clean": "rimraf .next .turbo *.tsbuildinfo || true"
  },
  "dependencies": {
    "@kshema/types": "workspace:*",
    "@kshema/ui": "workspace:*",
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@kshema/config": "workspace:*",
    "@kshema/encryption": "workspace:*",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.7",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
