# Kshema local development environment.
# Copy to `.env` and adjust as needed. Never commit real secrets.

# --- PostgreSQL 16 ---
POSTGRES_USER=kshema
POSTGRES_PASSWORD=kshema_dev_password
POSTGRES_DB=kshema
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kshema:kshema_dev_password@localhost:5432/kshema?schema=public

# --- Redis 7 (BullMQ) ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- MinIO (S3-compatible object store) ---
MINIO_ROOT_USER=kshema
MINIO_ROOT_PASSWORD=kshema_dev_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=kshema
S3_SECRET_KEY=kshema_dev_password
S3_BUCKET=kshema-blackbox

# --- App runtime ---
NODE_ENV=development
# API service
PORT=3001
HOST=0.0.0.0
# Dev-only fallbacks are used automatically when NODE_ENV != production.
# Set REAL secrets in production (the API refuses to boot without them).
JWT_SECRET=dev-insecure-jwt-secret-change-me
OTP_SECRET=dev-insecure-otp-secret-change-me
WHATSAPP_APP_SECRET=dev-insecure-whatsapp-app-secret-change-me
SUBSCRIPTION_WEBHOOK_SECRET=dev-insecure-subscription-webhook-secret-change-me
WEB_ORIGIN=http://localhost:3000,http://localhost:3002
EVENTS_QUEUE_NAME=sentinel-events
EMERGENCY_PORTAL_BASE_URL=http://localhost:3000/emergency
# Next.js front ends -> persistent Fastify service
KSHEMA_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Silence Prisma's cosmetic 'update available' banner
PRISMA_HIDE_UPDATE_MESSAGE=true
CHECKPOINT_DISABLE=1
