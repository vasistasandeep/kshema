{
  "name": "@kshema/config",
  "version": "0.1.0",
  "private": true,
  "description": "Shared ESLint/Prettier/TS presets + the no-banned-terms ESLint rule (full Brand_Lexicon + locale equivalents, scoped philosophy exceptions) and a dependency-free Banned_Term scanner for repo-wide enforcement",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./scan": {
      "types": "./src/scan-banned-terms.ts",
      "default": "./src/scan-banned-terms.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"@kshema/config lint placeholder\"",
    "test": "vitest run",
    "clean": "rimraf dist .turbo *.tsbuildinfo || true"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
