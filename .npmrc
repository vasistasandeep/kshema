auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false

# Expo / React Native / Metro must be resolvable in a flat layout for the
# Metro bundler to load its config and cache correctly under pnpm. Without
# these hoist patterns, Metro can resolve a mismatched version and fail with
# ERR_PACKAGE_PATH_NOT_EXPORTED (e.g. "./src/stores/FileStore"). Combined with
# the metro@0.80.12 overrides in package.json, this keeps a single, correct
# Metro on disk for Expo SDK 51.
public-hoist-pattern[]=*metro*
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=@react-native/*
public-hoist-pattern[]=@expo/*
public-hoist-pattern[]=expo-*
public-hoist-pattern[]=@react-navigation/*