{
  "name": "@kshema/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Kshema Expo/React Native mobile app shell (identity, disclaimer gate, key recovery, role-based surfaces)",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "gen:icons": "node scripts/gen-icons.mjs",
    "build": "echo \"@kshema/mobile build runs via EAS (expo) - see README; CI verifies the domain layer typecheck+test\"",
    "typecheck": "tsc -p tsconfig.domain.json --noEmit",
    "typecheck:app": "tsc --noEmit",
    "lint": "vitest run src/banned-terms.lint.test.ts",
    "test": "vitest run --passWithNoTests",
    "dev": "expo start",
    "clean": "rimraf .expo .turbo || true"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.0",
    "@kshema/types": "workspace:*",
    "@kshema/encryption": "workspace:*",
    "@kshema/ui": "workspace:*",
    "@kshema/config": "workspace:*",
    "expo": "~51.0.0",
    "expo-constants": "~16.0.0",
    "expo-crypto": "~13.0.0",
    "expo-linking": "~6.3.0",
    "expo-router": "~3.5.0",
    "expo-secure-store": "~13.0.0",
    "expo-status-bar": "~1.12.0",
    "nativewind": "^4.0.1",
    "react-native-css-interop": "0.2.7",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-quick-crypto": "0.7.11",
    "@craftzdog/react-native-buffer": "^6.1.2",
    "pako": "^2.1.0",
    "stream-browserify": "^3.0.0",
    "readable-stream": "^4.7.0",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.79",
    "fast-check": "3.19.0",
    "rimraf": "^5.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}