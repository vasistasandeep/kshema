auto-install-peers=true
strict-peer-dependencies=false

# Expo / React Native native builds (EAS `gradlew`, `expo prebuild`) run Gradle
# scripts that resolve `react-native` and Expo autolinking via `require.resolve`
# from a flat node_modules. pnpm's default symlinked store breaks that and yields
# "Error resolving plugin [id: 'com.facebook.react.settings'] > Included build
# '.../android/null' does not exist". `node-linker=hoisted` gives a flat,
# npm/yarn-style node_modules so the native monorepo build (and Metro) resolve
# correctly. This is Expo's recommended setting for pnpm monorepos.
node-linker=hoisted
